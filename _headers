# Cloudflare Pages response headers for every path. The site loads only its own stylesheet and images, runs no script,
# and has no forms, frames or cookies, so everything else is refused.
# Cache-Control keeps Pages' default (public, max-age=0, must-revalidate) and adds no-transform, which stops Cloudflare
# injecting its Web Analytics beacon: https://developers.cloudflare.com/web-analytics/faq/ It may also stop Cloudflare
# compressing at the edge (https://developers.cloudflare.com/cache/concepts/cache-control/), which costs a few KB on
# pages this small. Another rule matching a path would comma-join its Cache-Control onto this one, not replace it.
/*
  Cache-Control: public, max-age=0, must-revalidate, no-transform
  Content-Security-Policy: default-src 'none'; style-src 'self'; img-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: accelerometer=(), autoplay=(), browsing-topics=(), camera=(), display-capture=(), encrypted-media=(), fullscreen=(), geolocation=(), gyroscope=(), hid=(), idle-detection=(), interest-cohort=(), magnetometer=(), microphone=(), midi=(), payment=(), picture-in-picture=(), publickey-credentials-get=(), screen-wake-lock=(), serial=(), usb=(), xr-spatial-tracking=()
  X-Frame-Options: DENY
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  Strict-Transport-Security: max-age=31536000
